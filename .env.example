# Copy to .env and supply your own credentials. Never commit .env.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna

# Optional: actual reported organization costs in the administrator's /status.
# Keep the admin key private; it is separate from the normal model API key.
# OPENAI_ADMIN_KEY=your-openai-admin-key
# Optional: restrict the Costs API query to one project; default is the whole organization.
# OPENAI_COST_PROJECT_ID=proj_example

TT_HOST=teamtalk.example.com
TT_TCP_PORT=10333
TT_UDP_PORT=10333
TT_ENCRYPTED=false
TT_USERNAME=gpt-bot
TT_PASSWORD=your-teamtalk-password

TT_LICENSE_NAME=your-bearware-registration-name
TT_LICENSE_KEY=your-bearware-license-key

TT_NICKNAME=Chat GPT
TT_STATUS=If you need help, send me a message.
TT_CHANNEL=/
TT_CHANNEL_PASSWORD=

# Optional: try a second password only if TeamTalk rejects the first.
# TT_PASSWORD_FALLBACK=another-password

# Default for manual runs. The systemd unit overrides this automatically.
# BOT_DATA_DIR=data
